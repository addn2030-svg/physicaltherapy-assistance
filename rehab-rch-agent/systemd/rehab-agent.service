[Unit]
Description=Rehab RCH Agent v2 (Telegram + Gemini + Drive)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Template paths for user 'ubuntu' + default clone location.
# scripts/setup_oracle.sh rewrites User/paths for your VM automatically.
User=ubuntu
WorkingDirectory=/home/ubuntu/physicaltherapy-assistance/rehab-rch-agent
EnvironmentFile=/home/ubuntu/physicaltherapy-assistance/rehab-rch-agent/.env
ExecStart=/home/ubuntu/physicaltherapy-assistance/rehab-rch-agent/.venv/bin/python /home/ubuntu/physicaltherapy-assistance/rehab-rch-agent/bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
