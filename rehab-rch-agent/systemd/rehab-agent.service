[Unit]
Description=Rehab RCH Agent v2 (Telegram + Gemini + Drive)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust user + paths to your Oracle Cloud VM:
User=ubuntu
WorkingDirectory=/home/ubuntu/rehab-rch-agent
EnvironmentFile=/home/ubuntu/rehab-rch-agent/.env
ExecStart=/home/ubuntu/rehab-rch-agent/.venv/bin/python /home/ubuntu/rehab-rch-agent/bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
