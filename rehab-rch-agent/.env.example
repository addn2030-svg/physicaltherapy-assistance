# =====================================================================
# Rehab RCH Agent v2 — environment template
# Copy to .env and fill in:  cp .env.example .env
# NEVER commit .env or credentials.json to GitHub.
# =====================================================================

# --- Telegram (from @BotFather) -------------------------------------------
TELEGRAM_BOT_TOKEN=1234567890:PASTE_YOUR_BOT_TOKEN_HERE
# Optional: comma-separated admin Telegram IDs (can manage /kb reload etc.)
TELEGRAM_ADMIN_IDS=
# Staff enrollment code for /register (share with supervisors only; unset = closed)
ENROLL_CODE=

# --- Google Gemini (https://aistudio.google.com/app/apikey) ---------------
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.4
GEMINI_MAX_TOKENS=2048

# --- Google service account (Drive + Sheets) -------------------------------
# Path to the service-account JSON downloaded from Google Cloud Console.
GOOGLE_CREDENTIALS_FILE=credentials.json
# Drive root folder name to create/use (shared with the service account).
DRIVE_ROOT_FOLDER_NAME=Rehab RCH Agent
# Optional: pin an existing Drive folder ID instead of looking up by name.
DRIVE_ROOT_FOLDER_ID=

# Google Sheet holding staff access: columns "Telegram ID | Name | Role".
# Paste the Spreadsheet ID from its URL (.../d/<SPREADSHEET_ID>/edit).
STAFF_SHEET_ID=
STAFF_SHEET_TAB=Staff

# --- Operations workbook (Agent v3: Rehab_Operations_Master_v2 mirror) -----
# Spreadsheet ID of the ops Google Sheet (see docs/SHEETS_OPS.md).
# Empty = ops commands (/briefing, /daily, ...) reply "not connected".
OPS_SHEET_ID=

# --- Proactive orchestra (Agent v4: scheduler + escalation) -----------------
SCHED_ENABLED=true
SCHED_TZ=Asia/Riyadh
BRIEFING_TIME=07:30
GAP_SCAN_TIMES=09:00,12:00,15:00
REPORT_CUTOFF=15:00
ROLLUP_TIME=17:00
WEEKLY_DAY=SUN
WEEKLY_TIME=08:00
WATCHDOG_MINUTES=30
QUIET_HOURS=22:00-06:30
ALERT_DEDUP_HOURS=6
# Higher admin chat IDs (weekly summary + critical alerts only)
HIGHER_ADMIN_CHAT_IDS=

# --- Reminders + evaluation (Agent v4.2) ------------------------------------
REMINDER_TIMES=08:15
EVAL_DAY=1
EVAL_TIME=08:00
# Weekend days excluded from evaluation working-days % (Saudi: Fri/Sat)
EVAL_WEEKEND=FRI,SAT

# --- Email (Agent v4.2: memos, reminders, eval digests) ----------------------
# Empty SMTP_HOST = email disabled (bot-only mode). Works with any provider
# (Gmail: smtp.gmail.com:587 + App Password; hospital SMTP likewise).
EMAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=rehab-rch@hospital.local

# --- Google Calendar (Agent v4.2: reminders, agendas) ------------------------
# Empty = disabled. Share the calendar with the service-account email first.
CALENDAR_ENABLED=true
GOOGLE_CALENDAR_ID=

# --- Audit trail (Phase 2 safety rails) ------------------------------------
# Local JSONL is always on (output/audit/). Sheet mirror needs Editor access.
AUDIT_SHEET_TAB=AuditLog
AUDIT_SHEET_ENABLED=true

# --- Retention: local generated files older than this are cleanup candidates
RETENTION_DAYS=365
KB_MANIFEST_FILE=manifest.json

# --- Fallback access (used only when STAFF_SHEET_ID is empty) --------------
# Comma-separated Telegram numeric IDs, e.g. 123456789,987654321
ALLOWED_TELEGRAM_IDS=
STAFF_ALLOWLIST_FILE=staff_allowlist.json

# --- Department branding ---------------------------------------------------
DEPARTMENT_NAME=Rehabilitation Department — RCH
SECTION_HEAD_NAME=Abdulrahman Bakor Howsawy
SECTION_HEAD_TITLE=Rehabilitation Section Head

# --- Paths / logging --------------------------------------------------------
KNOWLEDGE_DIR=knowledge
OUTPUT_DIR=output
LOG_LEVEL=INFO
