# =====================================================================
# Rehab RCH Agent v2 — environment template
# Copy to .env and fill in:  cp .env.example .env
# NEVER commit .env or credentials.json to GitHub.
# =====================================================================

# --- Telegram (from @BotFather) -------------------------------------------
TELEGRAM_BOT_TOKEN=1234567890:PASTE_YOUR_BOT_TOKEN_HERE
# Optional: comma-separated admin Telegram IDs (can manage /kb reload etc.)
TELEGRAM_ADMIN_IDS=

# --- Google Gemini (https://aistudio.google.com/app/apikey) ---------------
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.4
GEMINI_MAX_TOKENS=2048

# --- Google service account (Drive + Sheets) -------------------------------
# Path to the service-account JSON downloaded from Google Cloud Console.
GOOGLE_CREDENTIALS_FILE=credentials.json
# Drive root folder name to create/use (shared with the service account).
DRIVE_ROOT_FOLDER_NAME=Rehab RCH Agent
# Optional: pin an existing Drive folder ID instead of looking up by name.
DRIVE_ROOT_FOLDER_ID=

# Google Sheet holding staff access: columns "Telegram ID | Name | Role".
# Paste the Spreadsheet ID from its URL (.../d/<SPREADSHEET_ID>/edit).
STAFF_SHEET_ID=
STAFF_SHEET_TAB=Staff

# --- Fallback access (used only when STAFF_SHEET_ID is empty) --------------
# Comma-separated Telegram numeric IDs, e.g. 123456789,987654321
ALLOWED_TELEGRAM_IDS=
STAFF_ALLOWLIST_FILE=staff_allowlist.json

# --- Department branding ---------------------------------------------------
DEPARTMENT_NAME=Rehabilitation Department — RCH
SECTION_HEAD_NAME=Abdulrahman Bakor Howsawy
SECTION_HEAD_TITLE=Rehabilitation Section Head

# --- Paths / logging --------------------------------------------------------
KNOWLEDGE_DIR=knowledge
OUTPUT_DIR=output
LOG_LEVEL=INFO
